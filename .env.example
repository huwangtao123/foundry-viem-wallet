# Agent runtime env
AGENT_KEYSTORE_PATH=/Users/taowang/.foundry/keystores/my-agent
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Preferred with Doppler (split secret mode)
# Part A in Doppler, Part B entered by user each run
AGENT_KEY_PART_A=replace_with_doppler_secret
AGENT_KEY_DERIVE_SALT=replace_with_random_salt
REQUIRE_DOPPLER_SPLIT=1

# Optional legacy direct password mode
# To allow fallback, set REQUIRE_DOPPLER_SPLIT=0
# AGENT_KEYSTORE_PASSWORD=replace_me

# Only needed for send command
TO_ADDRESS=0x000000000000000000000000000000000000dEaD
SEND_AMOUNT_ETH=0.0001
